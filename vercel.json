{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix debug-dojo/frontend install",
  "buildCommand": "npm --prefix debug-dojo/frontend run build",
  "outputDirectory": "debug-dojo/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "debug-dojo/backend/**"
    }
  }
}

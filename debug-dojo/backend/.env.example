# =======================================================
# Debug Dojo Environment Configuration
# =======================================================

# 1. Google Gemini API Key (Required for AI Problem Analysis & Progressive Coaching)
# Get your free API key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Judge0 API for Isolated Code Execution
# Default public CE endpoint (no key required for low volume): https://ce.judge0.com
# For RapidAPI Judge0: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# 3. Security & Database Settings
JWT_SECRET=debug_dojo_jwt_secret_key_2026_secured_key
DEBUG_DOJO_DB=debug_dojo.db
